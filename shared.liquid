{% template title_bar %}
<div class="title_bar">
  <img class="image image-dither" src="data:image/png;base64,">
  {% if layout_style == 'full' or layout_style == 'half-horizontal' %}
  <span class="title">{{ IDX_0.page.name }}</span>
  {% endif %}
  <span class="instance">
    Updated {{ updated_iso | l_date: mask_datetime, trmnl.user.locale }}
  </span>
</div>
{% endtemplate %}

{% template main %}
{% if trmnl.plugin_settings.custom_fields_values.timemode == '24_hour' %}
{% assign mask_datetime = '%-m/%-d %H:%M' %}
{% else %}
{% assign mask_datetime = '%-m/%-d %-I:%M%P' %}
{% endif %}

{% assign updated_iso = trmnl.system.timestamp_utc | date: "%s" | plus: trmnl.user.utc_offset | date: "%Y-%m-%dT%H:%M:%S%z" %}

{% unless IDX_0 %}
<div class="layout layout--center">
  <span class="label label--gray lg:label--large">No status data available</span>
</div>
{% render 'title_bar', IDX_0: IDX_0, trmnl: trmnl, layout_style: layout_style, updated_iso: updated_iso, mask_datetime: mask_datetime %}
{% endunless %}

{% if IDX_0 %}
{% assign incident_count = IDX_0.activeIncidents.size | default: 0 %}
{% assign maintenance_count = IDX_0.activeMaintenances.size | default: 0 %}
{% assign total_issues = incident_count | plus: maintenance_count %}

{% comment %} Determine page status display text {% endcomment %}
{% if IDX_0.page.status == 'UP' %}
  {% assign page_status_text = 'All Systems Operational' %}
{% elsif IDX_0.page.status == 'UNDERMAINTENANCE' %}
  {% assign page_status_text = 'Under Maintenance' %}
{% else %}
  {% assign page_status_text = 'Issues Detected' %}
{% endif %}

{% if total_issues == 0 %}
{%- comment -%} All clear: center the status prominently {%- endcomment -%}
<div class="layout layout--center">
  <div class="flex flex--col flex--center gap--small lg:gap--medium">
    <span class="title lg:title--large text--center">{{ IDX_0.page.name }}</span>
    <span class="label lg:label--large">{{ page_status_text }}</span>
  </div>
</div>

{% else %}
<div class="layout layout--col">
  {% comment %} Top: Page name + status summary {% endcomment %}
  <div class="flex flex--row flex--center-y gap--small">
    <span class="title title--large lg:title--xlarge">{{ IDX_0.page.name }}</span>
    {% if IDX_0.page.status == 'UNDERMAINTENANCE' %}
    <span class="label label--small lg:label--base label--outline no-shrink">Under Maintenance</span>
    {% else %}
    <span class="label label--small lg:label--base label--inverted 4bit:label--outline no-shrink">Issues Detected</span>
    {% endif %}
  </div>

  {% comment %} Below: Incidents + Maintenances list with overflow {% endcomment %}
  <div class="columns h--full" data-overflow="true" data-overflow-max-cols="1" data-overflow-max-cols-lg="2" data-overflow-max-cols-portrait="1" data-overflow-counter="true">
    <div class="column">

      {% if incident_count > 0 %}
      <span class="label lg:label--large">Active Incidents</span>

      {% for incident in IDX_0.activeIncidents %}
        {% assign emphasis = '' %}
        {% assign status_text = incident.status %}
        {% if incident.status == 'INVESTIGATING' %}
          {% assign emphasis = ' item--emphasis-3' %}
          {% assign status_text = 'Investigating' %}
        {% elsif incident.status == 'IDENTIFIED' %}
          {% assign emphasis = ' item--emphasis-2' %}
          {% assign status_text = 'Identified' %}
        {% elsif incident.status == 'MONITORING' %}
          {% assign emphasis = ' item--emphasis-1' %}
          {% assign status_text = 'Monitoring' %}
        {% elsif incident.status == 'RESOLVED' %}
          {% assign status_text = 'Resolved' %}
        {% endif %}

        <div class="item{{ emphasis }}">
          <div class="meta"></div>
          <div class="content">
            <div class="flex flex--row flex--center-y">
              <span class="title title--small lg:title--base" data-clamp="1" data-clamp-lg="2">{{ incident.name }}</span>
              {% if incident.status == 'MONITORING' %}
              <span class="label label--small label--outline no-shrink">{{ status_text }}</span>
              {% else %}
              <span class="label label--small label--inverted 4bit:label--outline no-shrink">{{ status_text }}</span>
              {% endif %}
            </div>
            {% if incident.start %}
            {% assign start_local = incident.start | date: "%s" | plus: trmnl.user.utc_offset | date: "%Y-%m-%dT%H:%M:%S%z" %}
            <span class="label label--small label--underline">
              {{ start_local | l_date: mask_datetime, trmnl.user.locale }}
            </span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
      {% endif %}

      {% if maintenance_count > 0 %}
      <span class="label lg:label--large">Scheduled Maintenance</span>

      {% for maint in IDX_0.activeMaintenances %}
        {% assign emphasis = '' %}
        {% assign status_text = maint.status %}
        {% if maint.status == 'INPROGRESS' %}
          {% assign emphasis = ' item--emphasis-2' %}
          {% assign status_text = 'In Progress' %}
        {% elsif maint.status == 'NOTSTARTEDYET' %}
          {% assign emphasis = ' item--emphasis-1' %}
          {% assign status_text = 'Scheduled' %}
        {% elsif maint.status == 'COMPLETED' %}
          {% assign status_text = 'Completed' %}
        {% endif %}

        {% assign duration_h = maint.duration | default: 0 | divided_by: 60 %}
        {% assign duration_m = maint.duration | default: 0 | modulo: 60 %}

        <div class="item{{ emphasis }}">
          <div class="meta"></div>
          <div class="content">
            <div class="flex flex--row flex--center-y">
              <span class="title title--small lg:title--base" data-clamp="1" data-clamp-lg="2">{{ maint.name }}</span>
              {% if maint.status == 'INPROGRESS' %}
              <span class="label label--small label--inverted 4bit:label--outline no-shrink">{{ status_text }}</span>
              {% else %}
              <span class="label label--small label--outline no-shrink">{{ status_text }}</span>
              {% endif %}
            </div>
            {% assign start_local = maint.start | date: "%s" | plus: trmnl.user.utc_offset | date: "%Y-%m-%dT%H:%M:%S%z" %}
            <div class="flex gap--small">
              <span class="label label--small label--underline">
                {{ start_local | l_date: mask_datetime, trmnl.user.locale }}
                {% if duration_h > 0 %} - {{ duration_h }}h{% endif %}{% if duration_m > 0 %} {{ duration_m }}m{% endif %}
              </span>
            </div>
          </div>
        </div>
      {% endfor %}
      {% endif %}

    </div>
  </div>
</div>
{% endif %}

{% render 'title_bar', IDX_0: IDX_0, trmnl: trmnl, layout_style: layout_style, updated_iso: updated_iso, mask_datetime: mask_datetime %}
{% endif %}
{% endtemplate %}
