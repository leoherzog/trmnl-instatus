{%- comment -%}
Instatus on a Vestaboard (6x22 flaps). This is the text of the single Composer text layer in
vestaboard.json. With nothing active, the page name and status sit between two rows of status
color; otherwise a header row leads a list of incidents and maintenances.
{%- endcomment -%}

{%- capture nl %}
{% endcapture -%}
{%- assign sp = '                      ' -%}

{%- comment -%} Times shift by each entry's own utcOffset from the transform; without an offset, status rows show no time. {%- endcomment -%}
{%- assign offset = utcOffset | default: trmnl.user.utc_offset -%}
{%- if offset -%}
{%- assign now = trmnl.system.timestamp_utc | default: 'now' | date: '%s' | plus: 0 -%}
{%- assign today = now | plus: offset | divided_by: 86400 -%}
{%- endif -%}

{%- comment -%} Entries as '~'-joined lists. Incident flaps follow impact, maintenance is blue. Only a lone entry shows its update. {%- endcomment -%}
{%- assign flaps = '' -%}
{%- assign names = '' -%}
{%- assign details = '' -%}
{%- assign update = '' -%}
{%- assign worst = 0 -%}

{%- for incident in activeIncidents -%}
{%- case incident.impact -%}
{%- when 'MAJOROUTAGE' -%}{%- assign rank = 3 -%}{%- assign flap = '{63}' -%}
{%- when 'DEGRADEDPERFORMANCE' -%}{%- assign rank = 1 -%}{%- assign flap = '{65}' -%}
{%- else -%}{%- assign rank = 2 -%}{%- assign flap = '{64}' -%}
{%- endcase -%}
{%- if rank > worst -%}{%- assign worst = rank -%}{%- endif -%}
{%- assign detail = incident.status | default: '' -%}
{%- if offset and incident.started -%}
{%- assign shift = incident.utcOffset | default: offset -%}
{%- assign local = incident.started | date: '%s' | plus: shift -%}
{%- assign day = local | divided_by: 86400 -%}
{%- if day == today -%}{%- assign when = local | date: '%-I:%M%p' -%}{%- else -%}{%- assign when = local | date: '%b %-d' -%}{%- endif -%}
{%- assign detail = detail | append: ' ' | append: when | strip -%}
{%- endif -%}
{%- assign name = incident.name | default: 'Incident' | remove: '~' -%}
{%- assign flaps = flaps | append: flap | append: '~' -%}
{%- assign names = names | append: name | append: '~' -%}
{%- assign details = details | append: detail | append: '~' -%}
{%- assign update = incident.lastUpdate | remove: '~' -%}
{%- endfor -%}

{%- for maint in activeMaintenances -%}
{%- assign at = nil -%}
{%- case maint.status -%}
{%- when 'NOTSTARTEDYET' -%}
{%- assign detail = 'SCHEDULED' -%}{%- assign verb = 'STARTS' -%}
{%- if maint.start -%}{%- assign at = maint.start | date: '%s' | plus: 0 -%}{%- endif -%}
{%- when 'INPROGRESS' -%}
{%- assign detail = 'IN PROGRESS' -%}{%- assign verb = 'UNTIL' -%}
{%- assign seconds = maint.duration | plus: 0 | times: 60 -%}
{%- if maint.start and seconds > 0 -%}{%- assign at = maint.start | date: '%s' | plus: seconds -%}{%- endif -%}
{%- when 'COMPLETED' -%}{%- assign detail = 'COMPLETED' -%}
{%- else -%}{%- assign detail = maint.status | default: '' -%}
{%- endcase -%}
{%- if offset and at -%}
{%- assign shift = maint.utcOffset | default: offset -%}
{%- assign local = at | plus: shift -%}
{%- assign days = local | divided_by: 86400 | minus: today -%}
{%- if days == 0 -%}{%- assign fmt = '%-I:%M%p' -%}
{%- elsif days > -7 and days < 7 -%}{%- assign fmt = '%a %-I:%M%p' -%}
{%- else -%}{%- assign fmt = '%b %-d %-I:%M%p' -%}
{%- endif -%}
{%- assign when = local | date: fmt -%}
{%- assign detail = verb | append: ' ' | append: when -%}
{%- endif -%}
{%- assign name = maint.name | default: 'Maintenance' | remove: '~' -%}
{%- assign flaps = flaps | append: '{67}~' -%}
{%- assign names = names | append: name | append: '~' -%}
{%- assign details = details | append: detail | append: '~' -%}
{%- assign update = maint.lastUpdate | remove: '~' -%}
{%- endfor -%}

{%- assign flaps = flaps | split: '~' -%}
{%- assign details = details | split: '~' -%}
{%- assign count = flaps.size -%}

{%- case page.status -%}
{%- when 'UP' -%}{%- assign page_flap = '{66}' -%}
{%- when 'UNDERMAINTENANCE' -%}{%- assign page_flap = '{67}' -%}
{%- else -%}
{%- case worst -%}
{%- when 3 -%}{%- assign page_flap = '{63}' -%}
{%- when 1 -%}{%- assign page_flap = '{65}' -%}
{%- else -%}{%- assign page_flap = '{64}' -%}
{%- endcase -%}
{%- endcase -%}

{%- comment -%} Wrap the page name, each entry name and a lone entry's update to rows of 21 cells. {%- endcomment -%}
{%- assign title = page.name | default: trmnl.plugin_settings.instance_name | default: 'Instatus' | remove: '~' -%}
{%- assign texts = title | append: '~' | append: names -%}
{%- if count == 1 -%}
{%- assign texts = texts | append: update -%}
{%- endif -%}
{%- assign texts = texts | strip_html | replace: '’', "'" | replace: '—', '-' | replace: '–', '-' | remove: '|' | split: '~' -%}
{%- assign wrapped = '' -%}
{%- for text in texts -%}
{%- assign rows = '' -%}
{%- assign row = '' -%}
{%- assign words = text | split: ' ' -%}
{%- for word in words -%}
{%- assign w = word | slice: 0, 21 -%}
{%- assign joined = row | append: ' ' | append: w -%}
{%- if row == '' -%}
{%- assign row = w -%}
{%- elsif joined.size <= 21 -%}
{%- assign row = joined -%}
{%- else -%}
{%- assign rows = rows | append: row | append: '|' -%}
{%- assign row = w -%}
{%- endif -%}
{%- endfor -%}
{%- assign wrapped = wrapped | append: rows | append: row | append: '~' -%}
{%- endfor -%}
{%- assign wrapped = wrapped | split: '~' -%}
{%- assign title_rows = wrapped[0] | split: '|' -%}

{%- if page == blank or count == 0 -%}

{%- comment -%} Banner: status color rows framing the page name and a two-line status. {%- endcomment -%}
{%- if page == blank -%}
{%- assign page_flap = '' -%}
{%- assign line1 = 'NO STATUS DATA' -%}
{%- assign line2 = '' -%}
{%- elsif page.status == 'UP' -%}
{%- assign line1 = 'ALL SYSTEMS' -%}
{%- assign line2 = 'OPERATIONAL' -%}
{%- elsif page.status == 'UNDERMAINTENANCE' -%}
{%- assign line1 = 'UNDER' -%}
{%- assign line2 = 'MAINTENANCE' -%}
{%- else -%}
{%- assign line1 = 'ISSUES DETECTED' -%}
{%- assign line2 = affectedLabel | default: '' -%}
{%- endif -%}
{%- assign stripe = '' -%}
{%- for i in (1..22) -%}{%- assign stripe = stripe | append: page_flap -%}{%- endfor -%}
{%- assign lines = title_rows[0] | append: '~' | append: title_rows[1] | append: '~' | append: line1 | append: '~' | append: line2 | split: '~' -%}
{%- assign out = stripe -%}
{%- for i in (0..3) -%}
{%- assign line = lines[i] | default: '' -%}
{%- assign pad = 22 | minus: line.size | divided_by: 2 | at_least: 0 -%}
{%- assign indent = sp | slice: 0, pad -%}
{%- assign out = out | append: nl | append: indent | append: line -%}
{%- endfor -%}
{%- assign out = out | append: nl | append: stripe -%}

{%- else -%}

{%- comment -%} Past five entries, the last row becomes "+N MORE". {%- endcomment -%}
{%- assign shown = count -%}
{%- assign more = 0 -%}
{%- if count > 5 -%}
{%- assign shown = 4 -%}
{%- assign more = count | minus: 4 -%}
{%- endif -%}
{%- assign left = 5 | minus: shown -%}
{%- if more > 0 -%}{%- assign left = left | minus: 1 -%}{%- endif -%}

{%- comment -%} Spare rows go to every name's second row, then every status row, then third name rows. {%- endcomment -%}
{%- assign name_rows = '' -%}
{%- assign status_rows = '' -%}
{%- for i in (1..shown) -%}
{%- assign name_rows = name_rows | append: '1,' -%}
{%- assign status_rows = status_rows | append: '0,' -%}
{%- endfor -%}
{%- for pass in (1..3) -%}
{%- assign names_in = name_rows | split: ',' -%}
{%- assign status_in = status_rows | split: ',' -%}
{%- assign name_rows = '' -%}
{%- assign status_rows = '' -%}
{%- for n in names_in -%}
{%- assign k = forloop.index0 -%}
{%- assign name_n = n | plus: 0 -%}
{%- assign status_n = status_in[k] | plus: 0 -%}
{%- assign rows = wrapped[forloop.index] | split: '|' -%}
{%- if left > 0 -%}
{%- if pass == 2 -%}
{%- if details[k] != blank -%}{%- assign status_n = 1 -%}{%- assign left = left | minus: 1 -%}{%- endif -%}
{%- elsif rows.size > name_n -%}
{%- assign name_n = name_n | plus: 1 -%}{%- assign left = left | minus: 1 -%}
{%- endif -%}
{%- endif -%}
{%- assign name_rows = name_rows | append: name_n | append: ',' -%}
{%- assign status_rows = status_rows | append: status_n | append: ',' -%}
{%- endfor -%}
{%- endfor -%}
{%- assign name_rows = name_rows | split: ',' -%}
{%- assign status_rows = status_rows | split: ',' -%}

{%- assign out = page_flap | append: title_rows[0] -%}
{%- for flap in flaps limit: shown -%}
{%- assign k = forloop.index0 -%}
{%- assign rows = wrapped[forloop.index] | split: '|' -%}
{%- assign n = name_rows[k] | plus: 0 -%}
{%- for row in rows limit: n -%}
{%- if forloop.first -%}{%- assign lead = flap -%}{%- else -%}{%- assign lead = ' ' -%}{%- endif -%}
{%- assign out = out | append: nl | append: lead | append: row -%}
{%- endfor -%}
{%- if status_rows[k] == '1' -%}
{%- assign detail = details[k] | slice: 0, 21 -%}
{%- assign out = out | append: nl | append: ' ' | append: detail -%}
{%- endif -%}
{%- endfor -%}

{%- if count == 1 and left > 0 -%}
{%- assign rows = wrapped[2] | split: '|' -%}
{%- for row in rows limit: left -%}
{%- assign out = out | append: nl | append: ' ' | append: row -%}
{%- endfor -%}
{%- endif -%}

{%- if more > 0 -%}
{%- assign out = out | append: nl | append: ' +' | append: more | append: ' MORE' -%}
{%- endif -%}

{%- endif -%}
{{- out -}}
